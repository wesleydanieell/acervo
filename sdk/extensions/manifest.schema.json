{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Acervo declarative source v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "name",
    "baseUrl",
    "searchPath"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "apiVersion": {
      "const": 1,
      "default": 1
    },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,8})\\.(0|[1-9][0-9]{0,8})\\.(0|[1-9][0-9]{0,8})$",
      "default": "1.0.0"
    },
    "adapter": {
      "enum": [
        "json",
        "opds",
        "html"
      ],
      "default": "json"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{2,63}$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "description": {
      "type": "string",
      "maxLength": 500
    },
    "baseUrl": {
      "type": "string",
      "format": "uri",
      "pattern": "^https://"
    },
    "searchPath": {
      "type": "string",
      "maxLength": 1000,
      "pattern": "^/(?!/).*\\{query\\}"
    },
    "itemsPath": {
      "$ref": "#/$defs/requiredSelector"
    },
    "titleField": {
      "$ref": "#/$defs/requiredSelector"
    },
    "authorField": {
      "$ref": "#/$defs/optionalSelector"
    },
    "formatField": {
      "$ref": "#/$defs/optionalSelector"
    },
    "languageField": {
      "$ref": "#/$defs/optionalSelector"
    },
    "downloadUrlField": {
      "$ref": "#/$defs/optionalSelector"
    },
    "formats": {
      "$ref": "#/$defs/codes"
    },
    "languages": {
      "$ref": "#/$defs/codes"
    },
    "localSearch": {
      "type": "boolean",
      "default": false
    },
    "remoteIdField": {
      "$ref": "#/$defs/optionalSelector"
    },
    "pagination": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "required": [
        "initialCursor",
        "nextCursorField"
      ],
      "properties": {
        "initialCursor": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        "nextCursorField": {
          "$ref": "#/$defs/requiredSelector"
        }
      }
    },
    "downloadDomains": {
      "type": [
        "array",
        "null"
      ],
      "maxItems": 20,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9-]+(\\.[a-z0-9-]+)+$"
      }
    },
    "html": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "required": [
        "itemSelector",
        "titleSelector"
      ],
      "properties": {
        "itemSelector": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "titleSelector": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "authorSelector": {
          "type": "string",
          "minLength": 0,
          "maxLength": 200
        },
        "languageSelector": {
          "type": "string",
          "minLength": 0,
          "maxLength": 200
        },
        "idSelector": {
          "type": "string",
          "minLength": 0,
          "maxLength": 200
        },
        "downloadSelector": {
          "type": "string",
          "minLength": 0,
          "maxLength": 200
        },
        "nextSelector": {
          "type": "string",
          "minLength": 0,
          "maxLength": 200
        }
      }
    },
    "editions": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "required": [
        "itemsField",
        "formatField",
        "downloadUrlField"
      ],
      "properties": {
        "itemsField": {
          "$ref": "#/$defs/requiredSelector"
        },
        "formatField": {
          "$ref": "#/$defs/requiredSelector"
        },
        "downloadUrlField": {
          "$ref": "#/$defs/requiredSelector"
        },
        "languageField": {
          "$ref": "#/$defs/optionalSelector"
        },
        "publisherField": {
          "$ref": "#/$defs/optionalSelector"
        },
        "labelField": {
          "$ref": "#/$defs/optionalSelector"
        }
      }
    },
    "websiteUrl": {
      "type": [
        "string",
        "null"
      ],
      "format": "uri",
      "pattern": "^https://",
      "maxLength": 2047
    },
    "feedPath": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 1000,
      "pattern": "^/(?!/)"
    }
  },
  "$defs": {
    "requiredSelector": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "optionalSelector": {
      "type": "string",
      "maxLength": 200
    },
    "codes": {
      "type": "array",
      "maxItems": 25,
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9-]{1,25}$"
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "adapter": {
            "const": "opds"
          }
        },
        "required": [
          "adapter"
        ]
      },
      "then": {
        "required": [
          "downloadDomains"
        ],
        "properties": {
          "downloadDomains": {
            "type": "array"
          },
          "pagination": {
            "type": "null"
          },
          "localSearch": {
            "const": false
          },
          "itemsPath": {
            "const": ""
          },
          "titleField": {
            "const": ""
          },
          "authorField": {
            "const": ""
          },
          "formatField": {
            "const": ""
          },
          "languageField": {
            "const": ""
          },
          "downloadUrlField": {
            "const": ""
          },
          "remoteIdField": {
            "const": ""
          },
          "html": {
            "type": "null"
          }
        }
      },
      "else": {
        "if": {
          "properties": {
            "adapter": {
              "const": "html"
            }
          },
          "required": [
            "adapter"
          ]
        },
        "then": {
          "required": [
            "downloadDomains",
            "html"
          ],
          "properties": {
            "downloadDomains": {
              "type": "array"
            },
            "pagination": {
              "type": "null"
            },
            "localSearch": {
              "const": false
            },
            "itemsPath": {
              "const": ""
            },
            "titleField": {
              "const": ""
            },
            "authorField": {
              "const": ""
            },
            "formatField": {
              "const": ""
            },
            "languageField": {
              "const": ""
            },
            "downloadUrlField": {
              "const": ""
            },
            "remoteIdField": {
              "const": ""
            },
            "html": {
              "type": "object"
            }
          }
        },
        "else": {
          "required": [
            "itemsPath",
            "titleField"
          ],
          "properties": {
            "html": {
              "type": "null"
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "editions": {
            "type": "object"
          }
        },
        "required": [
          "editions"
        ]
      },
      "then": {
        "required": [
          "remoteIdField",
          "downloadDomains"
        ],
        "properties": {
          "adapter": {
            "const": "json"
          },
          "remoteIdField": {
            "$ref": "#/$defs/requiredSelector"
          },
          "downloadDomains": {
            "type": "array"
          },
          "downloadUrlField": {
            "const": ""
          },
          "formatField": {
            "const": ""
          }
        }
      }
    }
  ]
}
