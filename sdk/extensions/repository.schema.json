{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Acervo extension repository index v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "name", "extensions"],
  "properties": {
    "schemaVersion": {"const": 1},
    "name": {"type": "string", "minLength": 1, "maxLength": 100},
    "extensions": {
      "type": "array", "minItems": 1, "maxItems": 100,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "name", "version", "manifestUrl", "sha256"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{2,63}$"},
          "name": {"type": "string", "minLength": 1, "maxLength": 100},
          "version": {"type": "string", "pattern": "^(0|[1-9][0-9]{0,8})\\.(0|[1-9][0-9]{0,8})\\.(0|[1-9][0-9]{0,8})$"},
          "manifestUrl": {"type": "string", "format": "uri", "pattern": "^https://[^?#]+$"},
          "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
        }
      }
    }
  }
}
